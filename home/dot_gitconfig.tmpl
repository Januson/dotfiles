[init]
  defaultBranch = master

[user]
  name = Ondrej Janus
{{ if .features.work }}
  email = {{ .git.work.email }}
{{ else }}
  email = {{ .git.home.email }}
{{ end }}

[core]
  excludesfile = ~/.gitignore
  editor = nvim

{{ if .features.work }}
[credential "{{ .git.work.address }}"]
  helper =
  helper = !{{ lookPath "gh" }} auth git-credential

{{ end }}
[branch]
  autosetuprebas = always

[branch "master"]
  remote = origin
  merge = refs/heads/master

[include]
  path = ~/.gitalias

[color]
  ui = true

[diff]
  tool = vimdiff

[push]
  default = simple
